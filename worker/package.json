{
  "name": "ryukyusurfbase-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "build:site": "npm --prefix .. run build",
    "deploy": "npm run build:site && wrangler deploy",
    "db:init:local": "wrangler d1 execute ryukyusurfbase --local --file=schema.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
